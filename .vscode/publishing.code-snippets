      "        </label>",
      "      </div>",
      "",
      "      <div class=\"form-field\">",
      "        <label class=\"choice\" for=\"form-switch-focus\">",
      "          <input class=\"choice__control choice__control--switch is-focus\" id=\"form-switch-focus\" name=\"form-switch-focus\" type=\"checkbox\" role=\"switch\" checked>",
      "          <span class=\"switch__track\" aria-hidden=\"true\"></span>",
      "          <span>포커스 스위치</span>",
      "        </label>",
      "      </div>",
      "",
      "      <div class=\"form-field\">",
      "        <label class=\"choice\" for=\"form-switch-disabled\">",
      "          <input class=\"choice__control choice__control--switch\" id=\"form-switch-disabled\" name=\"form-switch-disabled\" type=\"checkbox\" role=\"switch\" disabled>",
      "          <span class=\"switch__track\" aria-hidden=\"true\"></span>",
      "          <span>Disabled 스위치</span>",
      "        </label>",
      "      </div>",
      "",
      "      <div class=\"form-field is-error\">",
      "        <label class=\"choice\" for=\"form-switch-error\">",
      "          <input class=\"choice__control choice__control--switch\" id=\"form-switch-error\" name=\"form-switch-error\" type=\"checkbox\" role=\"switch\" aria-invalid=\"true\" aria-describedby=\"form-switch-error-message\">",
      "          <span class=\"switch__track\" aria-hidden=\"true\"></span>",
      "          <span>마케팅 수신 · 에러</span>",
      "        </label>",
      "        <p id=\"form-switch-error-message\" class=\"form-field__message form-field__message--error\">필수 입력 항목입니다.</p>",
      "      </div>",
      "",
      "      <div class=\"form-field is-success\">",
      "        <label class=\"choice\" for=\"form-switch-success\">",
      "          <input class=\"choice__control choice__control--switch\" id=\"form-switch-success\" name=\"form-switch-success\" type=\"checkbox\" role=\"switch\" checked aria-describedby=\"form-switch-success-message\">",
      "          <span class=\"switch__track\" aria-hidden=\"true\"></span>",
      "          <span>마케팅 수신 · 성공</span>",
      "        </label>",
      "        <p id=\"form-switch-success-message\" class=\"form-field__message form-field__message--success\"><span class=\"sr-only\">선택 성공: </span>수신 설정이 저장되었습니다.</p>",
      "      </div>",
      "    </div>",
      "    <p class=\"form-field__hint\">switch는 readonly를 지원하지 않습니다. 변경할 수 없는 값은 disabled 또는 별도 텍스트로 표시합니다.</p>",
      "  </div>",
      "</section>"
    ],
    "description": "폼 — input | textarea | select | checkbox | radio | switch"
  },
